# Discord OAuth2
DISCORD_1529558164544946288
DISCORD_SIdphNIgClOvCWZ-_134ybHVje2uO7xt
REDIRECT_URI=https://rezenith.online/api/auth/callback

# Discord Bot Token (for fetching guild/member info)
DISCORD_BOT_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
GUILD_ID=your_guild_id_here

# Session secret — generate a long random string
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Bot display name
BOT_NAME=Zenith

# (Optional) URL to your bot's internal metrics API
# BOT_API_URL=https://your-bot-host.com

# Role IDs (right-click role in Discord → Copy ID)
ROLE_ADMIN=
ROLE_MODERATOR=
ROLE_SUPPORT=
ROLE_MEMBER=
ROLE_VERIFIED=

# Channel IDs (right-click channel → Copy ID)
